<div tabindex="0" class="focus:outline-none">
  <div class="mx-auto container py-8">
    <!-- Sorting and Filtering Controls -->
    <div class="flex items-center justify-center mb-6 space-x-4">
      <!-- Sorting -->
      <form>
        <label for="sort_by" class="block text-sm font-medium text-gray-700">Sort By</label>
        <select
          id="sort_by"
          name="sort_by"
          class="mt-1 block pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md"
          phx-change="sort"
        >
          <%= for {label, value} <- @sort_options do %>
            <option value={value} selected={@sort_by == value}><%= label %></option>
          <% end %>
        </select>
      </form>

      <!-- Filtering -->
      <form>
        <label for="filter_category" class="block text-sm font-medium text-gray-700">Filter by Category</label>
        <select
          id="filter_category"
          name="filter_category"
          class="mt-1 block pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md"
          phx-change="filter"
        >
          <option value="">All Categories</option>
          <%= for category <- @categories do %>
            <option value={category.id} selected={@filter_category == category.id}><%= category.name %></option>
          <% end %>
        </select>
      </form>
    </div>
    <div class="flex flex-wrap items-center lg:justify-between justify-center">
      <%= for product <- @products do %>
        <div tabindex="0" class="focus:outline-none mx-2 my-2 w-72 xl:mb-0 mb-8 shadow-lg rounded-lg overflow-hidden border border-gray-200 bg-white">
          <div>
            <img
              alt={product.name}
              src="https://cdn.tuk.dev/assets/templates/classified/Bitmap.png"
              tabindex="0"
              class="focus:outline-none w-full h-44 object-cover"
            />
          </div>
          <div class="p-4">
            <div class="flex items-center justify-between">
              <h2 tabindex="0" class="focus:outline-none text-lg font-semibold"><%= product.name %></h2>
              <p tabindex="0" class="focus:outline-none text-xs text-gray-600">Inventory: <%= product.inventory_count %></p>
            </div>
            <p tabindex="0" class="focus:outline-none text-xs text-gray-600 mt-2"><%= product.description %></p>

            <div class="flex items-center justify-between mt-4">
              <h2 tabindex="0" class="focus:outline-none text-indigo-700 text-xs font-semibold">Category: <%= product.category.name %></h2>
              <h3 tabindex="0" class="focus:outline-none text-indigo-700 text-xl font-semibold">$<%= product.price %></h3>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-6 flex justify-center space-x-2">
      <%= if @page > 1 do %>
        <button class="px-4 py-2 bg-gray-300 rounded-md" phx-click="previous_page">Previous</button>
      <% end %>
      <button class="px-4 py-2 bg-gray-300 rounded-md" phx-click="next_page">Next</button>
    </div>
  </div>
</div>
