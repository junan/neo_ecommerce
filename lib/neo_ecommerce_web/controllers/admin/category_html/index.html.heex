<section id="torch-toolbar">
  <div class="torch-container">
    <.link href={~p"/admin/categories/new"} class="torch-button">New Category</.link>
  </div>
</section>
<section id="torch-index-content">
  <div class="torch-container">
    <section id="torch-table">
    <%= if length(@categories) > 0 do %>
      <table>
        <thead>
          <tr>

              <th><%= table_link(@conn, "Name", :name) %></th>

            <th><span>Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <%= for category <- @categories do %>
            <tr>

                <td><%= category.name %></td>

              <td class="torch-actions">
                <span><.link href={~p"/admin/categories/#{category}"}><%= Torch.I18n.message("Show") %></.link></span>
                <span><.link href={~p"/admin/categories/#{category}/edit"}><%= Torch.I18n.message("Edit") %></.link></span>
                <span><.link href={~p"/admin/categories/#{category}"} method="delete" data-confirm={Torch.I18n.message("Are you sure?")}><%= Torch.I18n.message("Delete") %></.link></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= Torch.PaginationView.pagination(@conn) %>
    <% else %>
      <p class="torch-no-data">No Categories match your search.</p>
    <% end %>
    </section>
  </div>
</section>
