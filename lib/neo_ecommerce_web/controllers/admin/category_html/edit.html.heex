<section id="torch-toolbar">
  <div class="torch-container">
    <.link href={~p"/admin/categories"} class="torch-button"><%= Torch.I18n.message("Cancel") %></.link>
  </div>
</section>

<section id="torch-header-and-content">
  <div class="torch-container">
    <div class="header">
      <h3>Edit Category</h3>
    </div>
    <.category_form changeset={@changeset} action={~p"/admin/categories/#{@category}"} />
  </div>
</section>
