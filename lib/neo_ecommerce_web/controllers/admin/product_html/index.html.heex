<section id="torch-toolbar">
  <div class="torch-container">
    <.link href={~p"/admin/products/new"} class="torch-button">New Product</.link>
  </div>
</section>
<section id="torch-index-content">
  <div class="torch-container">
    <section id="torch-table">
    <%= if length(@products) > 0 do %>
      <table>
        <thead>
          <tr>

              <th><%= table_link(@conn, "Name", :name) %></th>

              <th><%= table_link(@conn, "Description", :description) %></th>

              <th><%= table_link(@conn, "Price", :price) %></th>

              <th><%= table_link(@conn, "Inventory count", :inventory_count) %></th>

            <th><span>Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <%= for product <- @products do %>
            <tr>

                <td><%= product.name %></td>

                <td><%= product.description %></td>

                <td><%= product.price %></td>

                <td><%= product.inventory_count %></td>

              <td class="torch-actions">
                <span><.link href={~p"/admin/products/#{product}"}><%= Torch.I18n.message("Show") %></.link></span>
                <span><.link href={~p"/admin/products/#{product}/edit"}><%= Torch.I18n.message("Edit") %></.link></span>
                <span><.link href={~p"/admin/products/#{product}"} method="delete" data-confirm={Torch.I18n.message("Are you sure?")}><%= Torch.I18n.message("Delete") %></.link></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= Torch.PaginationView.pagination(@conn) %>
    <% else %>
      <p class="torch-no-data">No Products match your search.</p>
    <% end %>
    </section>
  </div>
</section>
